using Gtk 4.0;

template $audio_window: Gtk.Window {
    title: "Audio Layer";
    styles ["audio-window"]

    child: Gtk.Overlay overlay {
        child: Gtk.Box {
            orientation: vertical;
            margin-start: 0;
            styles ["audio-layer"]

            Gtk.Box {
                margin-start: 10;
                margin-end: 10;
                margin-top: 10;
                margin-bottom: 10;
                orientation: horizontal;
                homogeneous: true;
                styles ["header"]

                $HeaderButton vol_button {}
                $HeaderButton mic_button {}
            }

            Gtk.Stack tabs {
                vexpand: true;
                transition-type: slide_left_right; 

                Gtk.StackPage {
                    name: "Volume-Tab";
                    title: "Volume";

                    child: Gtk.Box main_vol_container {
                        orientation: vertical;
                        spacing: 15;
                        margin-top: 20;
                        margin-bottom: 20;
                        margin-start: 20;
                        margin-end: 20;

                        Gtk.Box not_found_box_vol {
                            orientation: horizontal;
                            hexpand: true;
                            vexpand: true;
                            visible: false;
                            halign: center;
                            Gtk.Label {
                                label: "Pulseaudio not found";
                                halign: center;
                                valign: center;
                                hexpand: true;
                                vexpand: true;
                                styles ["error-not-found"]
                            }
                        }

                        Gtk.Box vol_widget_box {
                            orientation: horizontal;
                            spacing: 10;

                            Gtk.Label vol_label {
                                label: "0%";
                                margin-start: 5;
                                margin-end: 5;
                                styles ["percent-text"]
                            }
                        
                            Gtk.Scale vol_scale {
                                orientation: horizontal;
                                hexpand: true;
                                margin-start: 5;
                                margin-end: 5;
                                draw-value: false;
                                adjustment: Gtk.Adjustment { value: 0; lower: 0; upper: 1; step-increment: 0.01; };
                                styles ["volume-slider"]
                            }
                        
                            $MuteButton vol_mute_btn {}
                            $MenuButton vol_menu_btn {
                                styles ["audio-menu-button"]
                            }

                        }
                    };
                }

                Gtk.StackPage {
                    name: "Mic-Tab";
                    title: "Mic";

                    child: Gtk.Box main_mic_container {
                        orientation: vertical;
                        spacing: 15;
                        margin-top: 20;
                        margin-bottom: 20;
                        margin-start: 20;
                        margin-end: 20;

                        Gtk.Box not_found_box_mic {
                            orientation: horizontal;
                            hexpand: true;
                            vexpand: true;
                            visible: false;
                            halign: center;
                            Gtk.Label {
                                label: "Pulseaudio not found";
                                halign: center;
                                valign: center;
                                hexpand: true;
                                vexpand: true;
                                styles ["error-not-found"]
                            }
                        }

                        Gtk.Box mic_widget_box {
                            orientation: horizontal;
                            spacing: 10;

                            Gtk.Label mic_label {
                                label: "0%";
                                margin-start: 5;
                                margin-end: 5;
                                styles ["percent-text"]
                            }
                        
                            Gtk.Scale mic_scale {
                                orientation: horizontal;
                                hexpand: true;
                                margin-start: 5;
                                margin-end: 5;
                                draw-value: false;
                                adjustment: Gtk.Adjustment { value: 0; lower: 0; upper: 1; step-increment: 0.01; };
                                styles ["volume-slider"]
                            }
                        
                            $MuteButton mic_mute_btn {}
                            $MenuButton mic_menu_btn {
                                styles ["audio-menu-button"]
                            }

                        }
                    };
                }
            }
        }; 
    };
}